# ============================================================================
# Rural Hospital Economics Simulator — Environment Configuration
# Copy to .env and fill in values for your environment.
# NEVER commit .env to version control.
# ============================================================================

# Application
GENIE_ENV=dev
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGIN=http://localhost:8000

# Julia
JULIA_NUM_THREADS=auto
JULIA_PROJECT=/app

# Security — REQUIRED in production
# Generate with: julia -e 'using Random; println(randstring(64))'
SECRET_TOKEN=

# PostgreSQL
POSTGRES_DB=rhsim_dev
POSTGRES_USER=rhsim
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rhsim:CHANGEME@localhost:5432/rhsim_dev

# Redis (optional — for caching/job queue)
REDIS_URL=redis://localhost:6379/0

# Simulation limits
SIM_MAX_ITERATIONS=50000
SIM_DEFAULT_ITERATIONS=5000
SIM_TIMEOUT_SECONDS=600

# Data paths
DATA_UPLOADS_DIR=data/uploads
DATA_EXPORTS_DIR=data/exports
DATA_REFERENCE_DIR=data/reference

# ─── BugReport component (E27) ───────────────────────────────────────────────
# GitHub personal-access token with `repo` scope used to create issues.
# NEVER expose this value in page source, network responses, or JS bundles.
BUG_REPORT_GITHUB_TOKEN=
# Target repository for filed bug reports (owner/repo).
BUG_REPORT_REPO=timothyhartzog/hospital-economics
# Cloudflare Turnstile site key (public — safe to embed in HTML).
TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key (REQUIRED in production — server-side only).
TURNSTILE_SECRET_KEY=

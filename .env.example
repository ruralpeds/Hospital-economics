# ============================================================================
# Rural Hospital Economics Simulator — Environment Configuration
# Copy to .env and modify for your environment
# ============================================================================

# Application
GENIE_ENV=dev
PORT=8000
HOST=0.0.0.0

# Julia
JULIA_NUM_THREADS=auto
JULIA_PROJECT=/app

# Database (optional — only needed for persistent storage)
DATABASE_URL=postgresql://rhsim:rhsim_secret@localhost:5432/rhsim_dev

# Redis (optional — only needed for caching/job queue)
REDIS_URL=redis://localhost:6379/0

# Data paths
DATA_UPLOADS_DIR=data/uploads
DATA_EXPORTS_DIR=data/exports
DATA_REFERENCE_DIR=data/reference

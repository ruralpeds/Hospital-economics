// NURSE COST CALCULATOR
// ═══════════════════════════════════════════════════════════════
let staffChart = null;
function calcNurseCost() {
  const permSalary = +document.getElementById('sliderPermSalary').value;
  const benefits = +document.getElementById('sliderBenefits').value / 100;
  const travelRate = +document.getElementById('sliderTravelRate').value;
  const vacancies = +document.getElementById('sliderVacancies').value;

  document.getElementById('valPermSalary').textContent = '$' + comma(permSalary);
  document.getElementById('valBenefits').textContent = (benefits*100).toFixed(0) + '%';
  document.getElementById('valTravelRate').textContent = '$' + travelRate + '/hr';
  document.getElementById('valVacancies').textContent = vacancies + ' FTEs';

  const permTotal = permSalary * (1 + benefits);
  const travelAnnual = travelRate * 2080; // 40hr × 52wk
  const annualPremium = (travelAnnual - permTotal) * vacancies;
  const multiplier = travelAnnual / permTotal;

  const results = document.getElementById('nurseCostResults');
  results.innerHTML = `
    <div class="metric neutral">
      <span class="metric-val">${fmt(permTotal)}</span>
      <span class="metric-label">Permanent RN Total Cost</span>
      <span class="metric-sub">Salary + Benefits / Year</span>
    </div>
    <div class="metric ${multiplier>2?'bad':'warn'}">
      <span class="metric-val">${fmt(travelAnnual)}</span>
      <span class="metric-label">Travel RN Annual Cost</span>
      <span class="metric-sub">${multiplier.toFixed(1)}× permanent cost</span>
    </div>
    <div class="metric ${annualPremium>200000?'bad':'warn'}">
      <span class="metric-val">${fmt(annualPremium)}</span>
      <span class="metric-label">Annual Travel Premium</span>
      <span class="metric-sub">Extra cost for ${vacancies} traveler(s)</span>
    </div>
  `;

  // Staffing chart
  const permCost = 20 * permTotal; // Assume 20 permanent
  const travelCost = vacancies * travelAnnual;
  const scenarios = ['All Permanent', 'Current Mix', 'High Travel'];
  const permData = [23 * permTotal, (23 - vacancies) * permTotal, 15 * permTotal];
  const travData = [0, vacancies * travelAnnual, 8 * travelAnnual];

  if (staffChart) staffChart.destroy();
  staffChart = new Chart(document.getElementById('chartStaffing'), {
    type: 'bar',
    data: {
      labels: scenarios,
      datasets: [
        { label: 'Permanent Staff', data: permData, backgroundColor: COLORS.accent, borderRadius: 4 },
        { label: 'Travel Staff', data: travData, backgroundColor: COLORS.red, borderRadius: 4 },
      ]
    },
    options: { ...chartDefaults, scales: { ...chartDefaults.scales, x: { ...chartDefaults.scales.x, stacked: true }, y: { ...chartDefaults.scales.y, stacked: true,
      ticks: { ...chartDefaults.scales.y.ticks, callback: v => '$' + (v/1e6).toFixed(1) + 'M' }}}}
  });
}

// ═══════════════════════════════════════════════════════════════
// REH CONVERSION CALCULATOR
// ═══════════════════════════════════════════════════════════════
function calcREH() {
  const ipRev = +document.getElementById('rehIPRev').value * 1e6;
  const ipCost = +document.getElementById('rehIPCost').value * 1e6;
  const opRev = +document.getElementById('rehOPRev').value * 1e6;

  document.getElementById('valREHIPRev').textContent = '$' + (+document.getElementById('rehIPRev').value).toFixed(1) + 'M';
  document.getElementById('valREHIPCost').textContent = '$' + (+document.getElementById('rehIPCost').value).toFixed(1) + 'M';
  document.getElementById('valREHOPRev').textContent = '$' + (+document.getElementById('rehOPRev').value).toFixed(1) + 'M';

  const ipMargin = ipRev - ipCost;
  const rehFacilityPayment = 272866.30 * 12;
  const rehOutpatientBonus = opRev * 0.05;
  const costSavings = ipCost * 0.55; // Save ~55% of inpatient costs
  const netImpact = -ipRev + rehFacilityPayment + rehOutpatientBonus + costSavings - ipCost * 0.15; // Transition costs amortized

  const results = document.getElementById('rehResults');
  results.innerHTML = `
    <div class="metric ${ipMargin<0?'bad':'good'}">
      <span class="metric-val">${fmt(ipMargin)}</span>
      <span class="metric-label">Current IP Margin</span>
      <span class="metric-sub">${ipMargin<0?'Losing money on inpatient':'Profitable inpatient'}</span>
    </div>
    <div class="metric good">
      <span class="metric-val">${fmt(rehFacilityPayment)}</span>
      <span class="metric-label">Annual REH Payment</span>
      <span class="metric-sub">$272,866/mo × 12</span>
    </div>
    <div class="metric good">
      <span class="metric-val">${fmt(rehOutpatientBonus)}</span>
      <span class="metric-label">5% OP Add-on</span>
      <span class="metric-sub">Additional outpatient revenue</span>
    </div>
    <div class="metric ${netImpact>0?'good':'bad'}">
      <span class="metric-val">${fmt(netImpact)}</span>
      <span class="metric-label">Est. Net Annual Impact</span>
      <span class="metric-sub">${netImpact>0?'Conversion may be favorable':'Conversion may not be favorable'}</span>
    </div>
  `;
}

// ═══════════════════════════════════════════════════════════════
// BENCHMARKING RADAR CHART
// ═══════════════════════════════════════════════════════════════
let benchChart = null;
function updateBenchmark() {
  const margin = +document.getElementById('benchMargin').value;
  const cash = +document.getElementById('benchCash').value;
  const age = +document.getElementById('benchAge').value;
  const cr = +document.getElementById('benchCR').value;
  const occ = +document.getElementById('benchOcc').value;
  const fte = +document.getElementById('benchFTE').value;

  // Convert to percentiles (higher = better, except age and FTE where lower = better)
  const marginPctl = Math.min(100, Math.max(0, (margin + 10) / 20 * 100));
  const cashPctl = Math.min(100, Math.max(0, cash / 180 * 100));
  const agePctl = Math.min(100, Math.max(0, (25 - age) / 20 * 100));
  const crPctl = Math.min(100, Math.max(0, cr / 3.5 * 100));
  const occPctl = Math.min(100, Math.max(0, occ / 60 * 100));
  const ftePctl = Math.min(100, Math.max(0, (10 - fte) / 8 * 100));

  if (benchChart) benchChart.destroy();
  benchChart = new Chart(document.getElementById('chartBenchmark'), {
    type: 'radar',
    data: {
      labels: ['Operating\nMargin', 'Days Cash\non Hand', 'Age of Plant\n(newer=better)', 'Current\nRatio', 'Occupancy\nRate', 'Staffing\nEfficiency'],
      datasets: [
        { label: 'Your Hospital', data: [marginPctl, cashPctl, agePctl, crPctl, occPctl, ftePctl],
          backgroundColor: 'rgba(27,79,114,0.15)', borderColor: COLORS.accent, borderWidth: 2.5, pointRadius: 5, pointBackgroundColor: COLORS.accent },
        { label: '50th Percentile (Median)', data: [50,50,50,50,50,50],
          backgroundColor: 'rgba(149,165,166,0.08)', borderColor: COLORS.gray, borderWidth: 1.5, borderDash: [5,5], pointRadius: 0 },
        { label: '75th Percentile (Top Quartile)', data: [75,75,75,75,75,75],
          backgroundColor: 'rgba(39,174,96,0.06)', borderColor: COLORS.green, borderWidth: 1.5, borderDash: [3,3], pointRadius: 0 },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom', labels: { font: { family: "'Source Sans 3'", size: 12 }, padding: 16, usePointStyle: true }},
        tooltip: chartDefaults.plugins.tooltip },
      scales: { r: { beginAtZero: true, max: 100,
        ticks: { display: false },
        grid: { color: '#E0DDD5' },
        angleLines: { color: '#E0DDD5' },
        pointLabels: { font: { family: "'Source Sans 3'", size: 11, weight: 600 }, color: '#4A4A45' }}}
    }
  });
}


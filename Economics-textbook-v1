// ═══════════════════════════════════════════════════════════════
// FINANCIAL SIMULATOR
// ═══════════════════════════════════════════════════════════════
let simChartProj = null, simChartMargin = null, simChartPayer = null;

function runSimulation() {
  const edVisits = +document.getElementById('sliderED').value;
  const ipDischarges = +document.getElementById('sliderIP').value;
  const medicarePct = +document.getElementById('sliderMedicare').value / 100;
  const commercialPct = +document.getElementById('sliderCommercial').value / 100;
  const inflation = +document.getElementById('sliderInflation').value / 100;
  const travelPct = +document.getElementById('sliderTravel').value / 100;
  const alos = +document.getElementById('sliderALOS').value;
  
  // Update displays
  document.getElementById('valED').textContent = comma(edVisits);
  document.getElementById('valIP').textContent = comma(ipDischarges);
  document.getElementById('valMedicare').textContent = (medicarePct*100).toFixed(0) + '%';
  document.getElementById('valCommercial').textContent = (commercialPct*100).toFixed(0) + '%';
  document.getElementById('valInflation').textContent = (inflation*100).toFixed(1) + '%';
  document.getElementById('valTravel').textContent = (travelPct*100).toFixed(0) + '%';
  document.getElementById('valALOS').textContent = alos.toFixed(1);

  const medicaidPct = Math.max(0, 1 - medicarePct - commercialPct - 0.07);
  const selfPayPct = 0.07;

  // Revenue model (CAH cost-based for Medicare)
  const edRevenuePerVisit = 1450;
  const ipRevenuePerDay = 3200;
  const outpatientVisits = edVisits * 1.8;
  const opRevenuePerVisit = 420;
  const patientDays = ipDischarges * alos;

  const grossED = edVisits * edRevenuePerVisit;
  const grossIP = patientDays * ipRevenuePerDay;
  const grossOP = outpatientVisits * opRevenuePerVisit;
  const grossTotal = grossED + grossIP + grossOP;

  // Net revenue by payer (after contractual adjustments)
  const medicareNet = grossTotal * medicarePct * 0.48;   // CAH cost-based ~48% of charges
  const medicaidNet = grossTotal * medicaidPct * 0.28;    // Medicaid ~28% of charges
  const commercialNet = grossTotal * commercialPct * 0.62; // Commercial ~62% of charges
  const selfPayNet = grossTotal * selfPayPct * 0.15;       // Self-pay ~15% collection
  const totalRevenue = medicareNet + medicaidNet + commercialNet + selfPayNet;

  // Expense model
  const baseFTE = 65 + ipDischarges * 0.08 + edVisits * 0.003;
  const avgSalary = 58000;
  const benefitsRate = 0.30;
  const travelPremium = 1.85;
  const permFTE = baseFTE * (1 - travelPct);
  const travFTE = baseFTE * travelPct;
  const salaryExpense = permFTE * avgSalary * (1 + benefitsRate) + travFTE * avgSalary * travelPremium;
  const supplyExpense = totalRevenue * 0.18;
  const otherExpense = totalRevenue * 0.12;
  const depreciation = 1800000;
  const totalExpenses = salaryExpense + supplyExpense + otherExpense + depreciation;

  const margin = (totalRevenue - totalExpenses) / totalRevenue;
  const daysCash = (totalRevenue * 0.15) / ((totalExpenses - depreciation) / 365);

  // Update metric cards
  const mRev = document.getElementById('mRevenue');
  const mExp = document.getElementById('mExpenses');
  const mMar = document.getElementById('mMargin');
  const mCsh = document.getElementById('mCash');

  mRev.querySelector('.metric-val').textContent = fmt(totalRevenue);
  mExp.querySelector('.metric-val').textContent = fmt(totalExpenses);
  mMar.querySelector('.metric-val').textContent = (margin * 100).toFixed(1) + '%';
  mCsh.querySelector('.metric-val').textContent = daysCash.toFixed(0) + ' days';

  mMar.className = 'metric ' + (margin > 0.02 ? 'good' : margin > 0 ? 'warn' : 'bad');
  mCsh.className = 'metric ' + (daysCash > 60 ? 'good' : daysCash > 30 ? 'warn' : 'bad');

  // 5-year projection
  const years = ['Year 1','Year 2','Year 3','Year 4','Year 5'];
  const projRevenue = [], projExpenses = [], projMargin = [];
  let r = totalRevenue, e = totalExpenses;
  for (let i = 0; i < 5; i++) {
    if (i > 0) {
      r *= (1 + 0.015);  // Revenue grows slowly
      e *= (1 + inflation); // Costs inflate faster
    }
    projRevenue.push(r);
    projExpenses.push(e);
    projMargin.push(((r - e) / r) * 100);
  }

  // Draw charts
  if (simChartProj) simChartProj.destroy();
  simChartProj = new Chart(document.getElementById('chartSimProjection'), {
    type: 'line',
    data: {
      labels: years,
      datasets: [
        { label: 'Revenue', data: projRevenue, borderColor: COLORS.green, backgroundColor: COLORS.bgGreen, fill: true, tension: 0.3, borderWidth: 2.5, pointRadius: 4 },
        { label: 'Expenses', data: projExpenses, borderColor: COLORS.red, backgroundColor: COLORS.bgRed, fill: true, tension: 0.3, borderWidth: 2.5, pointRadius: 4 },
      ]
    },
    options: { ...chartDefaults, scales: { ...chartDefaults.scales,
      y: { ...chartDefaults.scales.y, ticks: { ...chartDefaults.scales.y.ticks, callback: v => '$' + (v/1e6).toFixed(1) + 'M' }}}}
  });

  if (simChartMargin) simChartMargin.destroy();
  simChartMargin = new Chart(document.getElementById('chartSimMargin'), {
    type: 'bar',
    data: {
      labels: years,
      datasets: [{
        label: 'Operating Margin %',
        data: projMargin,
        backgroundColor: projMargin.map(m => m >= 2 ? COLORS.green : m >= 0 ? COLORS.orange : COLORS.red),
        borderRadius: 6,
      }]
    },
    options: { ...chartDefaults, plugins: { ...chartDefaults.plugins, legend: { display: false }},
      scales: { ...chartDefaults.scales,
        y: { ...chartDefaults.scales.y, ticks: { ...chartDefaults.scales.y.ticks, callback: v => v.toFixed(1) + '%' }}}}
  });

  if (simChartPayer) simChartPayer.destroy();
  simChartPayer = new Chart(document.getElementById('chartSimPayer'), {
    type: 'doughnut',
    data: {
      labels: ['Medicare', 'Medicaid', 'Commercial', 'Self-Pay'],
      datasets: [{
        data: [medicareNet, medicaidNet, commercialNet, selfPayNet],
        backgroundColor: [COLORS.accent, COLORS.purple, COLORS.teal, COLORS.gray],
        borderWidth: 2, borderColor: '#fff',
      }]
    },
    options: { responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'right', labels: { font: { family: "'Source Sans 3'", size: 12 }, padding: 12, usePointStyle: true }},
        tooltip: { ...chartDefaults.plugins.tooltip, callbacks: { label: ctx => ` ${ctx.label}: ${fmt(ctx.parsed)}` }}}}
  });
}


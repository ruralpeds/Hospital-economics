function calcRatios() {
  const rev = +document.getElementById('ratioRevenue').value;
  const exp = +document.getElementById('ratioExpenses').value;
  const cash = +document.getElementById('ratioCash').value;
  const dep = +document.getElementById('ratioDeprec').value;
  const ca = +document.getElementById('ratioCA').value;
  const cl = +document.getElementById('ratioCL').value;

  const totalMargin = ((rev - exp) / rev * 100);
  const daysOnHand = cash / ((exp - dep) / 365);
  const currentRatio = ca / cl;

  const results = document.getElementById('ratioResults');
  results.innerHTML = `
    <div class="metric ${totalMargin>=2?'good':totalMargin>=0?'warn':'bad'}">
      <span class="metric-val">${totalMargin.toFixed(1)}%</span>
      <span class="metric-label">Total Margin</span>
      <span class="metric-sub">Benchmark: 2–4%</span>
    </div>
    <div class="metric ${daysOnHand>=60?'good':daysOnHand>=30?'warn':'bad'}">
